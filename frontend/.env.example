# ==========================================
# UniNet Frontend - Variables de Entorno
# ==========================================
# Copia este archivo a .env.local y configura tu IP de Tailscale
#
# Ejemplo:
#   cp .env.example .env.local
#   nano .env.local
# ==========================================

# URL del API Backend
# IMPORTANTE: Usa la IP de Tailscale de tu servidor Ubuntu
# Para obtenerla, ejecuta en el servidor: tailscale ip -4

VITE_API_URL=http://100.112.81.15:4000

# URL del endpoint de status (monitoreo de PCs)
VITE_STATUS_SERVER_URL=http://100.112.81.15:4000/health

# ==========================================
# Ejemplos de configuración por desarrollador:
# ==========================================
#
# Para Alex (servidor principal):
#   VITE_API_URL=http://100.112.81.15:4000
#   VITE_STATUS_SERVER_URL=http://100.112.81.15:4000/health
#
# Para Roy (servidor de desarrollo):
#   VITE_API_URL=http://100.96.133.34:4000
#   VITE_STATUS_SERVER_URL=http://100.96.133.34:4000/health
#
# Para Patrick (servidor de desarrollo):
#   VITE_API_URL=http://100.120.50.30:4000
#   VITE_STATUS_SERVER_URL=http://100.120.50.30:4000/health
#
# Para desarrollo local (si el backend está en la misma máquina):
#   VITE_API_URL=http://localhost:4000
#   VITE_STATUS_SERVER_URL=http://localhost:4000/health
#
# ==========================================
# Nota: Las IPs de Tailscale siempre empiezan con 100.x.x.x
# ==========================================
